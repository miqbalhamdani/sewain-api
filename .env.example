# S1-001 runs against PostgreSQL 18 and Redis 8 installed on the host, not in
# containers -- no docker, no compose. MinIO runs as a single binary too, and
# only locally; production uses Cloudflare R2. These values are also the
# compiled-in defaults, so a .env is only needed to deviate from them.
#
#   brew services start postgresql@18 redis
#   make db-create && make migrate

# The schema owner. cmd/migrate only -- locally this is a superuser, which
# bypasses row level security entirely.
DATABASE_URL=postgres://localhost:5432/sewain_dev?sslmode=disable

# app_user, which owns nothing. cmd/api serves every request on this one.
APP_DATABASE_URL=postgres://app_user@localhost:5432/sewain_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# MinIO, a single binary on the host. Production points this at R2 instead --
# same adapter, different endpoint and credentials.
#   minio server --address=:9000 ~/minio-data
OBJECT_STORE_URL=http://localhost:9000
# One private bucket; tenancy is the owner_id key prefix. Create it, with the
# 24h expiry on pending/, by running:  make storage-init
# OBJECT_STORE_BUCKET=sewain
# OBJECT_STORE_REGION=us-east-1          # R2: auto
# Development falls back to MinIO's minioadmin pair; anywhere else these two
# are required (S1-033).
# OBJECT_STORE_ACCESS_KEY=
# OBJECT_STORE_SECRET_KEY=
PORT=8080

# Mailpit, a single binary on the host. Production picks a real relay in M6.
#   brew install mailpit && mailpit      # :1025 SMTP, :8025 web UI
SMTP_ADDR=localhost:1025
MAIL_FROM=no-reply@sewain.local

# Where the links in outgoing mail point -- the backoffice origin.
APP_BASE_URL=http://localhost:3000

# AES-256 key for identity numbers (BR-085), 32 bytes as base64. Optional in
# development -- a fixed dev key is used -- and required everywhere else.
#   openssl rand -base64 32
# IDENTITY_ENC_KEY=
